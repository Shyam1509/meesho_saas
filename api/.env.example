# Copy to `.env` (development) or `.env.test` (used when NODE_ENV=test). Placeholders only:
# never commit real credentials. In production (NODE_ENV=production) no env file is read;
# set these as real environment variables instead.

# Runtime environment: development | test | production (required).
NODE_ENV=development

# HTTP port the API listens on (optional, default 3100).
PORT=3100

# MySQL host name or IP (required).
DB_HOST=127.0.0.1

# MySQL port (required).
DB_PORT=3306

# Database name (required). Use a separate database for tests, e.g. meesho_test in .env.test.
DB_NAME=meesho_dev

# MySQL user for the application (required; use a least-privilege app user, not root).
DB_USER=change_me

# Password for DB_USER (required, must not be empty).
DB_PASSWORD=change_me

# Comma-separated browser origins allowed by CORS, scheme://host[:port] (optional, default http://localhost:4310).
CORS_ORIGINS=http://localhost:4310

# Log level: fatal | error | warn | info | debug | trace | silent (optional, default info; always silent when NODE_ENV=test).
LOG_LEVEL=info

# --- Authentication (Milestone 3) ---

# Allow self-service sign-up via POST /auth/register: true | false (optional, default false).
# Handy in local development; keep it false in production until user creation is decided (M9).
AUTH_REGISTRATION_ENABLED=true

# Secure flag on the session and XSRF cookies: true | false (optional; default true when
# NODE_ENV=production, else false). Must be true in production (false is rejected there). When true the
# session cookie is named __Host-msaas_sid and only travels over HTTPS; leave false for http://localhost.
COOKIE_SECURE=false

# Session idle timeout in minutes: ends a session after this long without requests
# (optional, default 720 = 12 hours; 10..43200; must not exceed SESSION_ABSOLUTE_HOURS * 60).
SESSION_IDLE_MINUTES=720

# Absolute session lifetime in hours, however active (optional, default 168 = 7 days; 1..8760).
SESSION_ABSOLUTE_HOURS=168

# Requests per minute per client IP to each of POST /auth/login and POST /auth/register
# (optional, default 10; 1..10000). In-memory counter: one API instance only.
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Imports (Milestone 4) ---

# Largest import file accepted, in MB (optional, default 10; 1..50). Larger uploads are refused with 413.
IMPORT_MAX_FILE_MB=10

# Most non-blank data rows in one import file, all sheets together (optional, default 50000; 1..200000).
# A file with more rows is refused with 422 PARSE_ERROR (split it into smaller date ranges).
IMPORT_MAX_ROWS=50000
