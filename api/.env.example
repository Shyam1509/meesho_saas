# Copy to `.env` (development) or `.env.test` (used when NODE_ENV=test). Placeholders only:
# never commit real credentials. In production (NODE_ENV=production) no env file is read;
# set these as real environment variables instead.

# Runtime environment: development | test | production (required).
NODE_ENV=development

# HTTP port the API listens on (optional, default 3100).
PORT=3100

# MySQL host name or IP (required).
DB_HOST=127.0.0.1

# MySQL port (required).
DB_PORT=3306

# Database name (required). Use a separate database for tests, e.g. meesho_test in .env.test.
DB_NAME=meesho_dev

# MySQL user for the application (required; use a least-privilege app user, not root).
DB_USER=change_me

# Password for DB_USER (required, must not be empty).
DB_PASSWORD=change_me

# Comma-separated browser origins allowed by CORS, scheme://host[:port] (optional, default http://localhost:4300).
CORS_ORIGINS=http://localhost:4300

# Log level: fatal | error | warn | info | debug | trace | silent (optional, default info; always silent when NODE_ENV=test).
LOG_LEVEL=info
